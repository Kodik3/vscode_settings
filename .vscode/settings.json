{
	// theme
	"workbench.colorTheme": "Vague",
	"workbench.iconTheme": "material-icon-theme",

	// cursor
	"editor.cursorStyle": "line",
	"editor.cursorBlinking": "solid",
	"editor.cursorSmoothCaretAnimation": "on",
	"terminal.integrated.cursorStyle": "line",
	"terminal.integrated.cursorBlinking": true,

	// font: Fira Code | Departure Mono |
	"editor.fontFamily": "'Fira Code', Consolas, 'Courier New', monospace",
	"editor.fontSize": 14,
	"editor.fontLigatures": true,
	"terminal.integrated.fontFamily": "'Fira Code', Consolas, 'Courier New', monospace",
	"terminal.integrated.fontSize": 15,

	// minimap
	"editor.minimap.renderCharacters": false,
	"editor.minimap.enabled": false,

	// scroll
	"editor.smoothScrolling": true,
	"workbench.list.smoothScrolling": true,
	"terminal.integrated.smoothScrolling": true,
	// scrollbar
	"editor.scrollbar.vertical": "hidden",
	"editor.scrollbar.verticalScrollbarSize": 0,
	"editor.scrollbar.horizontalScrollbarSize": 9,

	// terminal
	"terminal.integrated.commandsToSkipShell": [
		"editor.action.clipboardPasteAction",
		"workbench.action.terminal.paste"
	],
	"terminal.integrated.copyOnSelection": true,
	"terminal.integrated.rightClickCopyPaste": true,

	"workbench.editorAssociations": {
		"*.jar": "default"
	},

	"editor.lineHeight": 1.5,
	"editor.rulers": [99],
	"workbench.editor.empty.hint": "hidden",
	"workbench.editor.pinnedTabsOnSeparateRow": true,
	"editor.renderLineHighlight": "none",
	"editor.tabSize": 2,
	// "editor.guides.bracketPairs": "active",
	"editor.lineNumbers": "on",
	"workbench.editor.tabActionLocation": "left",
	"workbench.tree.expandMode": "singleClick",
	"workbench.tree.indent": 10,
	"debug.onTaskErrors": "debugAnyway",
	"editor.inlayHints.enabled": "off",

	"editor.wordWrap": "on",
	"editor.unicodeHighlight.ambiguousCharacters": false,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"explorer.compactFolders": false,
	"editor.glyphMargin": false,
	"editor.linkedEditing": true,
	"editor.padding.top": 15,

	"editor.quickSuggestions": {
		"other": true,
		"comments": false,
		"strings": true
	},
	"javascript.suggestionActions.enabled": true,
	"typescript.suggestionActions.enabled": true,
	"emmet.includeLanguages": {
		"javascript": "javascriptreact",
		"typescript": "typescriptreact"
	},

	"editor.unicodeHighlight.invisibleCharacters": false,
	"workbench.tree.renderIndentGuides": "none",

	"files.associations": {
		"*.tpl": "html"
	},
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/dist/**": true,
		"**/.git/**": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/dist": true
	},

	"workbench.startupEditor": "none",
	"workbench.tips.enabled": false,
	"editor.guides.indentation": false,
	"editor.renderWhitespace": "none",
	"editor.matchBrackets": "never",
	"editor.lightbulb.enabled": "off",
	"editor.detectIndentation": false,
	"apc.activityBar": {
		"size": 30,
		"position": "bottom"
	},
	"apc.statusBar": {
		"position": "editor-bottom",
		"height": 20,
		"fontSize": 10
	},

	// Prettier
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"prettier.useTabs": true,
	"prettier.semi": false,
	"prettier.jsxSingleQuote": true,
	"prettier.singleQuote": true,
	"prettier.arrowParens": "avoid",
	"scss.format.enable": false,

	"git.openRepositoryInParentFolders": "never",
	"cSpell.language": "en,ru",
	"workbench.sideBar.location": "right",
	"window.zoomLevel": 1,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"editor.inlayHints.enabled": "off",
	"window.titleBarStyle": "native",
	"php.codeLens.enabled": false,
	"workbench.secondarySideBar.defaultVisibility": "hidden",

	// python
	"python.useEnvironmentsExtension": true,
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter"
	},
	"python.defaultInterpreterPath": "c:\\python313\\python.exe",
	"extensions.experimental.affinity": {
		"asvetliakov.vscode-neovim": 1
	},
	"codeium.enableCodeLens": false,
	"prettier.printWidth": 99,
	"git.suggestSmartCommit": false,
	"chat.viewSessions.orientation": "stacked",
	"window.customTitleBarVisibility": "never",
	"chat.agent.enabled": false
}
